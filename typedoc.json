{
  "name": "codemelted.js Project",
  "alwaysCreateEntryPointModule": true,
  "excludeExternals": true,
  "excludeProtected": true,
  "excludePrivate": true,
  "darkHighlightTheme": "dark-plus",
  "readme": "README.md",
  "entryPoints": [
    "./codemelted.js",
  ],
  "out": "docs",
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "markdown",
    "powershell",
    "tsx",
    "typescript",
    "yaml"
  ],
  "ignoredHighlightLanguages": ["mermaid"],
  "projectDocuments": [
    "documents/about.md",
    "documents/templates.md",
    "documents/tests.md"
  ]
}
